<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the application manifest. Default FCM channel, icon and colour for background notifications,
     plus the Android 13+ POST_NOTIFICATIONS permission (requested at runtime by PushNotificationService). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.sillycon.tallcrawl.notifications">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/tallcrawl_default_notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_tallcrawl" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/tallcrawl_notification_color" />
    </application>
</manifest>
